/**
 * @param {number[]} nums
 * @param {number} target
 * @return {number[]}
 */
var twoSum = function(nums, target) {
    let ans = new Map();
    let needed;

    for (let i = 0; i < nums.length; i++) {
        needed = target - nums[i];

        if (ans.has(needed)) {
            return [ans.get(needed), i];
        }

        ans.set(nums[i], i);
    }
};
